"""Mellanox HW management — BUILD.bazel added on claude branch.

Migration status: Phase 1 Bazel migration.
Build type: Make + debian packaging + Python scripts

Mellanox hw-mgmt contains kernel modules, systemd services, and Python
scripts for hardware management on Mellanox switches. The build produces
.deb packages via dpkg-buildpackage.
"""

load("//rules/bazel/deb:deb.bzl", "deb_package_set")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all_srcs",
    srcs = glob(
        ["**/*"],
        exclude = [".git/**", "build/**", "*.o", "*.ko"],
    ),
)

deb_package_set(
    name = "hw_mgmt_debs",
    srcs = [":all_srcs"],
    debian_dir = "debian",
    version = "$(PKG_VERSION)",
    declared_outputs = ["hw-management.deb"],
    visibility = ["//visibility:public"],
)

